# ThreatRAG Environment Configuration

# Service Ports
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Storage Paths
CHROMA_PERSIST_DIR=./artifacts/chroma_db
BM25_INDEX_PATH=./artifacts/bm25_index.pkl
MODEL_PATH=./artifacts/threat_classifier.joblib
SCALER_PATH=./artifacts/flow_scaler.joblib

# Model & Embedding Weights
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional External LLM Integration (ThreatRAG runs deterministically on CPU if unset)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Safety Gate
ENFORCE_HUMAN_APPROVAL=true
